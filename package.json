{
  "name": "goldrush",
  "version": "2.6.0",
  "description": "黄金投资研究 Agent — 八维全景分析 + 对数FHS预测 + 宏观预期差 + CRPS校准 + 防钓鱼证伪",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "goldrush": "dist/index.js"
  },
  "scripts": {
    "build": "node scripts/sync-web-cjs.mjs && tsc",
    "sync:web": "node scripts/sync-web-cjs.mjs",
    "sync:web:check": "node scripts/sync-web-cjs.mjs --check",
    "backfill:meta": "node scripts/backfill-meta.mjs",
    "dev": "node server.cjs",
    "cli": "tsx src/index.ts",
    "start": "node server.cjs",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^0.4.0",
    "@tavily/core": "^0.7.6",
    "better-sqlite3": "^11.7.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "isomorphic-dompurify": "^3.18.0",
    "marked": "^18.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
